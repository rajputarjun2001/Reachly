# Copy to .env (never commit it). One process serves the UI, the /api REST API and the workers.
PORT=3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MongoDB + Redis (start both locally with: npm run services:up)
MONGO_URI=mongodb://localhost:27017/reachly
REDIS_HOST=localhost
REDIS_PORT=6379

# Session JWT (min 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=30d

# AES-256-GCM key for LinkedIn passwords and session cookies: 64 hex chars (32 bytes).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Run BullMQ workers in this process (set false to run them elsewhere).
WORKERS_ENABLED=true

# Optional: one isolated Playwright browser container per LinkedIn account (requires Docker).
DOCKER_ENABLED=false
DOCKER_NETWORK=reachly-net
DOCKER_HOST_ADDRESS=127.0.0.1
# BROWSER_IMAGE=mcr.microsoft.com/playwright:v1.64.1-noble

# Playwright: "0" = Chromium in node_modules (required on Render; default in server.ts).
# PLAYWRIGHT_BROWSERS_PATH=0
