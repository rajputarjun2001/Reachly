{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "incremental": false
  },
  "include": ["server.ts", "server/**/*.ts", "server/**/*.d.ts"],
  "exclude": ["node_modules", "server/**/*.test.ts", "server/**/__mocks__/**", "server/test/**"]
}
