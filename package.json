{
  "name": "reachly",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false --exclude \"./src/**\" --exclude \"./.next/**\" server.ts",
    "build": "next build && tsc -p tsconfig.server.json && npm run browsers:install",
    "start": "cross-env NODE_ENV=production node dist/server.js",
    "lint": "next lint",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "browsers:install": "playwright install chromium"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.4.1",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "dockerode": "^5.0.1",
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.13",
    "lucide-react": "^1.61.0",
    "mongoose": "^9.11.4",
    "multer": "^2.5.0",
    "next": "^15.2.4",
    "playwright": "^1.64.1",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/cors": "^2.8.19",
    "@types/dockerode": "^4.0.2",
    "@types/express": "^4.17.25",
    "@types/multer": "^2.3.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "15.1.0",
    "jsdom": "^29.1.1",
    "mongodb-memory-server": "^11.3.0",
    "postcss": "^8",
    "supertest": "^7.3.1",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
